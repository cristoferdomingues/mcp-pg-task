# Connection used by the MCP server (prefer the restricted mcp_reader role)
DATABASE_URL=postgres://mcp_reader@localhost:5432/clinic

# Key used for tokenization (sha256 salt) and vault encryption (pgp_sym_encrypt).
# Never persisted in the database; passed as a function argument only.
PII_KEY=replace-with-a-long-random-secret

# Unlock switch for db.unmask. Keep false unless the harness deny-gate is
# deliberately opened by the operator.
PII_UNMASK_ENABLED=false

# Row caps enforced server-side regardless of what the agent asks for.
MAX_ROWS=200
DEFAULT_ROWS=50
