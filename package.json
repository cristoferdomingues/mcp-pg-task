{
  "name": "mcp-postgres-pii",
  "version": "0.1.0",
  "description": "MCP server exposing join-capable, PII-safe Postgres access with a minimal 3-tool surface (db.describe, db.query, db.unmask).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-postgres-pii": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "setup:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f sql/01_schema.sql -f sql/02_seed.sql"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "pg": "^8.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  }
}
